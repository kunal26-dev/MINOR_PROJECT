PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/smart_notes
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
MAX_FILE_SIZE_MB=20
FILE_STORAGE_DRIVER=local

# Configure these to enable password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional seed administrator.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
